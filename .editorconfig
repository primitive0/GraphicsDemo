root = true


[*]
end_of_line = lf
insert_final_newline = true

[*.nix]
charset = utf-8
trim_trailing_whitespace = true
indent_size = 2
indent_style = space

[meson.build]
charset = utf-8
trim_trailing_whitespace = true
indent_size = 2
indent_style = space

[*.{cpp,hpp}]
charset = utf-8
trim_trailing_whitespace = true
indent_size = 4
indent_style = space
